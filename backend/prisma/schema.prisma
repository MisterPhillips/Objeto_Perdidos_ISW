generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// ENUMS
// ============================

enum RolUsuario {
  FUNCIONARIO
  ESTUDIANTE
  ADMIN
}

enum EstadoObjeto {
  EN_REVISION
  DISPONIBLE
  ENTREGADO
}

enum EstadoSolicitudReclamo {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// ============================
// MODELOS Agregar booleana en objetos privado o publico, cambiar nombre de ubicacion a sede
// ============================

model Usuario {
  id         Int        @id @default(autoincrement())
  rol        RolUsuario @default(ESTUDIANTE)
  activo     Boolean    @default(true)
  nombre     String     @db.VarChar(100)
  correo     String     @unique @db.VarChar(150)
  contrasena String     @db.VarChar(255)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  objetosRegistrados Objeto[]
  solicitudesReclamo SolicitudReclamo[]
  retirosRealizados  Retiro[]

  @@map("usuarios")
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.Text
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objetos     Objeto[]

  @@map("categorias")
}

model PuntoRetiro {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(100)
  facultad   String   @db.VarChar(100)
  descripcion String? @db.Text
  habilitado Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  objetos    Objeto[]

  @@index([facultad])
  @@map("puntos_retiro")
}

model Objeto {
  id              Int          @id @default(autoincrement())
  descripcion     String       @db.VarChar(150)
  estado          EstadoObjeto @default(DISPONIBLE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  objetoPrivado   Boolean      @default(false)
  

  categoriaId     Int
  categoria       Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  puntoRetiroId   Int
  puntoRetiro     PuntoRetiro  @relation(fields: [puntoRetiroId], references: [id], onDelete: Restrict)

  registradoPorId Int
  registradoPor   Usuario      @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  
  solicitudesReclamo SolicitudReclamo[]
  retiro             Retiro?

  @@index([puntoRetiroId])
  @@index([categoriaId])
  @@index([estado])
  @@map("objetos")
}

model SolicitudReclamo {
  id        Int                     @id @default(autoincrement())
  detalle   String                  @db.VarChar(500)
  estado    EstadoSolicitudReclamo  @default(PENDIENTE)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  objetoId Int
  objeto   Objeto  @relation(fields: [objetoId], references: [id], onDelete: Restrict)

  @@index([usuarioId, estado])
  @@index([objetoId, estado])
  @@map("solicitudes_reclamo")
}

model Retiro {
  id                  Int      @id @default(autoincrement())
  nombreRetirante     String   @db.VarChar(100)
  rutRetirante        String   @db.VarChar(20)
  correoRetirante     String   @db.VarChar(150)
  fechaRetiro         DateTime @default(now())

  objetoId            Int      @unique
  objeto              Objeto   @relation(fields: [objetoId], references: [id], onDelete: Restrict)

  funcionarioId       Int
  funcionario         Usuario  @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)

  @@index([fechaRetiro])
  @@index([rutRetirante])
  @@map("retiros")
}
