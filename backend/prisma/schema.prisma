generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objetos     Objeto[]

  @@map("categorias")
}

model PuntoRetiro {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  facultad  String   @db.VarChar(100)
  ubicacion String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objetos   Objeto[]

  @@map("puntos_retiro")
}

model Objeto {
  id            Int         @id @default(autoincrement())
  descripcion   String      @db.VarChar(150)
  estado        String      @default("disponible") @db.VarChar(20)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  categoriaId   Int
  categoria     Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  puntoRetiroId Int
  puntoRetiro   PuntoRetiro @relation(fields: [puntoRetiroId], references: [id], onDelete: Restrict)

  @@map("objetos")
}

enum RolUsuario {
  FUNCIONARIO
  ESTUDIANTE
  ADMIN
}

model Usuario {
  id         Int      @id @default(autoincrement())
  rol        RolUsuario @default(ESTUDIANTE) 
  nombre     String   @db.VarChar(100)
  correo     String   @unique @db.VarChar(150)
  contrasena String   @db.VarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("usuarios")
}